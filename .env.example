# ---- LLM (OpenAI-compatible; swap base URL to use OpenRouter, Qwen, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_MANAGER=gpt-4o-mini
MODEL_SPECIALIST=gpt-4o-mini

# ---- Embeddings (kept separate so the chat provider can move independently)
EMBED_API_KEY=
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_MODEL=text-embedding-3-small

# ---- Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Tuning
CORPUS_LANG=id
DOCMAP=medium
MATCH_COUNT=5
RELATIVE_GAP=1
MATCH_THRESHOLD=0.40
HISTORY_TURNS=4
MAX_TOKENS_MANAGER=250
MAX_TOKENS_SPECIALIST=400
MAX_INPUT_CHARS=1000

# Requests per minute, per client address. Only enforced when the platform
# supplies a client address (x-real-ip / x-forwarded-for), so local development
# and the eval harness are unaffected.
RATE_LIMIT_PER_MIN=15

# ---- Naive baseline mode: stuffs the whole corpus, sends full history,
# skips retrieval. Used once to produce the "before" numbers in NOTES.md.
NAIVE_MODE=false
