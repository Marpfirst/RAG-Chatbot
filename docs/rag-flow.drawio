<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0">
  <diagram name="1 — Ingestion (seed)" id="ingest">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="1500" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t" value="Ingestion — npm run seed" style="text;html=1;fontSize=21;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ts" value="Dijalankan dari terminal, bukan saat user bertanya. Tidak ada bagian dari halaman ini yang berjalan di runtime." style="text;html=1;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="900" height="20" as="geometry" />
        </mxCell>

        <mxCell id="a1" value="docs/id/*.md&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;4 dokumen&lt;br&gt;ditulis tangan&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#333333;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="150" height="90" as="geometry" />
        </mxCell>

        <mxCell id="a2" value="Potong di tiap ##&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;38 potongan&lt;br&gt;tanpa tumpang tindih&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="240" y="150" width="160" height="90" as="geometry" />
        </mxCell>

        <mxCell id="a3" value="Tempel header konteks&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;[Harga Sigap &amp;gt; Paket Tumbuh]&lt;br&gt;~12 token&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="450" y="150" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="a4" value="Embed tiap potongan&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;text-embedding-3-small&lt;br&gt;38 panggilan · 1536 dimensi&lt;br&gt;jumlah token dibaca dari respons API&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="700" y="150" width="230" height="90" as="geometry" />
        </mxCell>

        <mxCell id="a5" value="DELETE where lang&lt;br&gt;lalu INSERT semua&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;bangun ulang, bukan tambal&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="980" y="150" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="a6" value="Supabase · tabel chunks&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;id, lang, doc, section&lt;br&gt;content, token_count&lt;br&gt;embedding vector(1536)&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="1220" y="140" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="Kumpulkan judul section&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;4 judul pertama per dokumen&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="240" y="360" width="210" height="70" as="geometry" />
        </mxCell>

        <mxCell id="b2" value="lib/docmap.json&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;tiga varian: full / medium / compact&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="500" y="360" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="b3" value="System prompt MANAGER&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;dasar keputusan: perlu cari dokumen atau tidak&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="750" y="360" width="250" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="Kenapa potong di heading, bukan per N karakter?&#10;&#10;Dokumennya ditulis sendiri, jadi batas antar-topik sudah ditentukan manusia.&#10;Chunker yang memotong per 500 karakter harus menebak di mana satu ide berakhir —&#10;itulah kenapa praktik umum menambah tumpang tindih 10-20% sebagai bantalan.&#10;Di sini bantalan itu tidak dibutuhkan, dan tumpang tindih hanya akan&#10;menduplikasi token di setiap pencarian." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="420" height="140" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="Kenapa header konteks ditempel ke isi chunk?&#10;&#10;Chunk diambil sendirian dan dibaca tanpa dokumen induknya.&#10;Tanpa header, potongan yang berbunyi &quot;Paket ini mencakup 8 kursi agen&quot;&#10;tidak punya rujukan untuk kata &quot;ini&quot;.&#10;&#10;Biayanya ~12 token per chunk, dibayar sekali saat seed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="500" y="520" width="420" height="140" as="geometry" />
        </mxCell>

        <mxCell id="n3" value="Hasil terukur (npm run seed mencetaknya)&#10;&#10;38 chunk · 3.034 token korpus&#10;chunk: min 58 · median 82 · maks 98 token&#10;biaya embedding: 3.034 token, sekali&#10;&#10;Baseline naif mengirim seluruh 3.034 token itu&#10;di SETIAP permintaan." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="980" y="520" width="460" height="140" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="cabang" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#6c8ebf;fontSize=11" edge="1" parent="1" source="a2" target="b1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#6c8ebf" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#6c8ebf" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="2 — Retrieval (per pertanyaan)" id="query">
    <mxGraphModel dx="1100" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="1200" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="qt" value="Retrieval — apa yang terjadi tiap pertanyaan" style="text;html=1;fontSize=21;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="qts" value="Hanya jalur ini yang berjalan saat user bertanya. Chunking dan embedding korpus sudah selesai jauh sebelumnya." style="text;html=1;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="900" height="20" as="geometry" />
        </mxCell>

        <mxCell id="q1" value="Pertanyaan user" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="330" y="110" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="q2" value="MANAGER&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;memutuskan DAN menulis ulang pertanyaan&lt;br&gt;jadi query pencarian yang mandiri&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="310" y="200" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="qd1" value="panggil&lt;br&gt;search_docs?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="350" y="320" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="qno" value="Selesai tanpa retrieval&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;pengetahuan umum atau penolakan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="230" height="70" as="geometry" />
        </mxCell>

        <mxCell id="q3" value="Gabung teks: pertanyaan asli + query manager&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;asli menjaga nama entitas, tulisan ulang menyelesaikan kata ganti&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="280" y="460" width="320" height="70" as="geometry" />
        </mxCell>

        <mxCell id="q4" value="Embed query&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;1 panggilan · ~15 token&lt;br&gt;dicatat di kolom embed_tokens sendiri&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="280" y="570" width="320" height="70" as="geometry" />
        </mxCell>

        <mxCell id="q5" value="match_chunks(vector, lang, k=5, floor=0,40)&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;cosine distance, ambang diterapkan di dalam SQL&lt;br&gt;sehingga chunk di bawah ambang tidak pernah keluar dari DB&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="260" y="680" width="360" height="80" as="geometry" />
        </mxCell>

        <mxCell id="qdb" value="tabel chunks&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;38 baris · tanpa index ANN&lt;br&gt;sequential scan instan&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="720" y="670" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="qd2" value="ada chunk&lt;br&gt;yang lolos?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="350" y="800" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="qnf" value="0 chunk&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;&lt;b&gt;specialist tidak dipanggil&lt;/b&gt;&lt;br&gt;jawaban tetap: tidak ada di dokumen&lt;br&gt;salah satu jalur TERMURAH&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="680" y="805" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="q6" value="SPECIALIST&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;terima: chunk + pertanyaan asli + query manager&lt;br&gt;&lt;b&gt;tanpa riwayat percakapan&lt;/b&gt;&lt;br&gt;instruksi: jawab HANYA dari konteks&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="280" y="950" width="320" height="90" as="geometry" />
        </mxCell>

        <mxCell id="qn1" value="Kenapa yang di-embed gabungan dua teks?&#10;&#10;Query manager saja: untuk &quot;Bedanya paket Tumbuh sama Skala apa?&quot;&#10;manager mempersempitnya dan kata &quot;Skala&quot; hilang — chunk itu&#10;tidak pernah masuk kandidat.&#10;&#10;Pertanyaan asli saja: pertanyaan susulan seperti&#10;&quot;kalau yang lebih besar?&quot; tidak punya makna sendiri.&#10;&#10;Gabungan: ~5 token embedding tambahan, kedua kekuatan tetap." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="680" y="440" width="440" height="190" as="geometry" />
        </mxCell>

        <mxCell id="qn2" value="Ambang 0,40 hasil pengukuran (npm run probe)&#10;&#10;pertanyaan yang ada jawabannya : 0,55 - 0,69&#10;pertanyaan perbandingan        : 0,55 - 0,61&#10;pertanyaan di luar korpus      : 0,28 - 0,44&#10;&#10;0,40 duduk di celah itu. Sempat dicoba 0,49 —&#10;lebih hemat, tapi ikut membunuh pertanyaan susulan." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="40" y="950" width="200" height="190" as="geometry" />
        </mxCell>

        <mxCell id="qe1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333" edge="1" parent="1" source="q1" target="q2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="qe2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333" edge="1" parent="1" source="q2" target="qd1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="qe3" value="tidak" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#6c8ebf;fontSize=11" edge="1" parent="1" source="qd1" target="qno"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="qe4" value="ya" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333;fontSize=11" edge="1" parent="1" source="qd1" target="q3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="qe5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333" edge="1" parent="1" source="q3" target="q4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="qe6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333" edge="1" parent="1" source="q4" target="q5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="qe7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;strokeColor=#b85450" edge="1" parent="1" source="qdb" target="q5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="qe8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333" edge="1" parent="1" source="q5" target="qd2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="qe9" value="tidak" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;fontSize=11" edge="1" parent="1" source="qd2" target="qnf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="qe10" value="ya" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333;fontSize=11" edge="1" parent="1" source="qd2" target="q6"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="3 — Kalau dokumen berubah" id="reindex">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="1500" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="rt" value="Kalau ada dokumen baru atau isinya diubah" style="text;html=1;fontSize=21;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="rts" value="Chunking bukan sekali seumur hidup — sekali per npm run seed. Yang dilakukan skrip itu bangun ulang total, bukan tambal sulam." style="text;html=1;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1000" height="20" as="geometry" />
        </mxCell>

        <mxCell id="r1" value="Edit docs/id/*.md&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;tambah dokumen, ubah satu kalimat,&lt;br&gt;atau ganti judul section&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#333333;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="r2" value="npm run seed" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="300" y="160" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="r3" value="DELETE FROM chunks WHERE lang = 'id'&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;seluruh korpus dibuang lebih dulu&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="540" y="150" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="r4" value="Embed ulang SEMUA 38 chunk&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;termasuk yang tidak berubah&lt;br&gt;38 panggilan · 3.034 token · beberapa detik&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="880" y="145" width="270" height="80" as="geometry" />
        </mxCell>

        <mxCell id="r5" value="INSERT semua baris&lt;br&gt;+ tulis ulang docmap.json" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="1210" y="150" width="230" height="70" as="geometry" />
        </mxCell>

        <mxCell id="g1" value="Untung dari bangun ulang total&#10;&#10;• Tidak ada chunk yatim. Ganti judul section berarti id-nya&#10;  berubah; kalau memakai upsert tanpa delete, baris lama&#10;  akan tertinggal selamanya dan tetap ikut dicari.&#10;&#10;• Tidak ada keadaan setengah jadi. Korpus selalu cocok&#10;  persis dengan isi berkas Markdown-nya.&#10;&#10;• Tidak ada kode pelacak perubahan yang perlu dipercaya." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="450" height="180" as="geometry" />
        </mxCell>

        <mxCell id="g2" value="Rugi dari bangun ulang total&#10;&#10;• Semua chunk di-embed ulang walau cuma satu yang berubah.&#10;  Di 38 chunk: 3.034 token, di bawah satu sen, beberapa detik.&#10;  Di 10.000 chunk: mahal dan lambat.&#10;&#10;• Ada jeda korpus kosong antara DELETE dan INSERT.&#10;  Pertanyaan yang masuk persis saat itu akan dijawab&#10;  &quot;tidak ada di dokumen&quot;. Beberapa detik, dan seed&#10;  dijalankan dari terminal — bukan oleh pengguna." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="530" y="330" width="450" height="180" as="geometry" />
        </mxCell>

        <mxCell id="g3" value="Kalau korpusnya jadi besar&#10;&#10;Jalur bertahapnya sudah terbuka, karena id chunk deterministik:&#10;  doc + '#' + slug(judul section)&#10;&#10;Yang perlu ditambah cuma satu kolom hash isi:&#10;  1. potong seperti biasa&#10;  2. hash tiap chunk&#10;  3. embed ulang HANYA yang hash-nya berubah&#10;  4. hapus id yang sudah tidak muncul lagi&#10;&#10;Tidak dikerjakan sekarang: di 38 chunk tidak ada masalah&#10;terukur yang perlu diselesaikan." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="1020" y="330" width="420" height="220" as="geometry" />
        </mxCell>

        <mxCell id="g4" value="Yang TIDAK perlu diubah saat dokumen berubah&#10;&#10;• System prompt manager — peta dokumen ditulis ulang otomatis oleh seed&#10;• Ambang kemiripan — dikalibrasi terhadap sebaran skor, bukan terhadap isi tertentu&#10;• Golden set — kecuali fakta yang di-assert ikut berubah&#10;&#10;Tapi jalankan ulang npm run eval sesudahnya. Korpus yang berubah menggeser&#10;sebaran skor, dan ambang yang tadinya pas bisa jadi tidak pas lagi." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="940" height="150" as="geometry" />
        </mxCell>

        <mxCell id="re1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333" edge="1" parent="1" source="r4" target="r5"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
