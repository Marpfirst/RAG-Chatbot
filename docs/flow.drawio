        <mxCell id="ex1" value="Baris 1 — agent: manager&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;input 328 · output 17 · embed 15&lt;br&gt;routed: true (dia melempar)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="400" y="155" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ex2" value="Baris 2 — agent: specialist&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;input 423 · output 16&lt;br&gt;retrieved_ids: 5 potongan&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="400" y="255" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ex3" value="Badge yang dilihat user&lt;br&gt;&lt;b&gt;specialist · 799 token&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;= jumlah kedua baris&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="400" y="365" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="why" value="Kenapa 1 baris per panggilan agent, bukan per jawaban?&#10;&#10;Kalau digabung jadi satu baris, ongkos delegasi jadi tidak terlihat.&#10;Dipisah, kita bisa menjawab pertanyaan seperti:&#10;   • berapa mahal keputusan melempar ke specialist?&#10;   • berapa besar porsi manager di total?&#10;   • berapa token yang dipakai embedding?&#10;&#10;Itu juga yang membuat perbandingan per kategori di NOTES.md&#10;bisa dihitung, bukan ditaksir." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="740" y="155" width="380" height="200" as="geometry" />
        </mxCell>

        <mxCell id="res_title" value="Hasil terukur — 18 pertanyaan uji" style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="400" y="490" width="500" height="25" as="geometry" />
        </mxCell>

        <mxCell id="res" value="&lt;b&gt;Versi naif&lt;/b&gt; (seluruh dokumen ditempel tiap kali)&#10;2.654 token per pertanyaan&#10;&#10;&lt;b&gt;Versi sekarang&lt;/b&gt;&#10;666 token per pertanyaan — turun 75%, 18/18 benar&#10;&#10;manager 440 · specialist 822 · di luar dokumen 647&#10;permintaan di luar domain 418 (naif: 3.296)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10" vertex="1" parent="1">
          <mxGeometry x="400" y="525" width="380" height="180" as="geometry" />
        </mxCell>

        <mxCell id="repro" value="Semuanya bisa dijalankan ulang:&#10;&#10;npm run seed        siapkan korpus&#10;npm run eval        18 pertanyaan uji + tabel token&#10;npx tsx scripts/probe.ts    sebaran skor kemiripan&#10;npx tsx scripts/repro.ts    konsistensi antar-giliran&#10;npx tsx scripts/smoke.ts    cek provider LLM&#10;&#10;NAIVE_MODE=true membangkitkan ulang angka &quot;sebelum&quot;." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="820" y="525" width="380" height="180" as="geometry" />
        </mxCell>

