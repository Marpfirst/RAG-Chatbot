        <mxCell id="ex_title" value="Contoh: satu pertanyaan yang butuh dokumen" style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="400" y="115" width="500" height="25" as="geometry" />
